{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "outcome",
    "design",
    "constraints",
    "scope",
    "acceptance",
    "checks",
    "tiers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "coding-harness.delivery/v2"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "design": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "checks",
          "scenario"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scenario": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tier",
          "command",
          "test_files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "tier": {
            "type": "string",
            "enum": [
              "unit",
              "integration",
              "e2e"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "test_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_failure": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tier",
          "status",
          "reason"
        ],
        "properties": {
          "tier": {
            "type": "string",
            "enum": [
              "unit",
              "integration",
              "e2e"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "covered",
              "not_applicable",
              "not_evaluated",
              "blocked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "follow_up": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
