      "requires": [
        "harness-drift"
      ]
    },
    {
      "id": "pack-sources",
      "paths": [
        "packs/**"
      ],
      "requires": [
        "harness-drift",
        "validate",
        "tests"
      ]
    },
    {
      "id": "docs",
      "paths": [
        "docs/**",
        "README.md"
      ],
      "requires": [
        "doctor",
        "validate",
        "metrics"
      ]
    }
  ],
