  "gates": [
    {
      "id": "harness-drift",
      "command": "./harness check --manifest harness.manifest.json",
      "protects": "all composed instructions and native skill exports match their pinned sources",
      "prove_fires": "corrupt a native skill export, then verify drift fails and sync restores it",
      "severity": "blocking",
      "prove_fires_command": "printf '\\n<!-- prove -->\\n' >> .agents/skills/verification-tiers/SKILL.md",
      "revert_command": "./harness sync --manifest harness.manifest.json",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "doctor",
      "command": "./harness doctor --manifest harness.manifest.json",
      "protects": "declared governance facts, owner routing and reachable context sources stay consistent",
      "prove_fires": "make a declared context source point to a missing file; doctor must fail",
      "prove_fires_command": "node -e \"const fs=require('fs');const p='harness.manifest.json';const m=JSON.parse(fs.readFileSync(p));m.governance.context.sources[0].path='__missing_context__.md';fs.writeFileSync(p,JSON.stringify(m,null,2)+'\\n')\"",
      "revert_command": "git restore -- harness.manifest.json",
      "severity": "blocking",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "validate",
      "command": "./harness validate --manifest harness.manifest.json",
      "protects": "declared skills and gates carry their required sections",
      "prove_fires": "remove ## Verification from a declared skill; expect exit 1",
      "severity": "blocking",
      "prove_fires_command": "node -e \"const fs=require('fs');const p='harness.manifest.json';const m=JSON.parse(fs.readFileSync(p));m.__prove=true;fs.writeFileSync(p,JSON.stringify(m,null,2)+'\\n')\"",
      "revert_command": "node -e \"const fs=require('fs');const p='harness.manifest.json';const m=JSON.parse(fs.readFileSync(p));delete m.__prove;fs.writeFileSync(p,JSON.stringify(m,null,2)+'\\n')\"",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "tests",
      "command": "npm test",
      "protects": "the CLI and its checks stay green",
      "prove_fires": "break a test expectation; expect exit 1",
      "severity": "blocking",
      "prove_fires_command": "node -e \"require('fs').writeFileSync('test/__prove.test.mjs','throw new Error()')\"",
      "revert_command": "node -e \"require('fs').rmSync('test/__prove.test.mjs',{force:true})\"",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "release",
      "command": "V=$(cat base/VERSION); mkdir -p .harness/tmp && OUT=$(mktemp -d .harness/tmp/release.XXXXXX); node bin/harness.mjs release --base base --out \"$OUT\" --version \"$V\" --force >/dev/null && diff -r \"$OUT/base@$V\" \"dist/base@$V\"; s=$?; rm -rf \"$OUT\"; exit $s",
      "protects": "the committed base release matches what base/ produces at the pinned version; the scratch directory lives under the ignored .harness/tmp so the gate also runs where the platform temp directory is not writable",
      "prove_fires": "append to base/AGENTS.base.md without re-releasing; the rebuilt artifact differs from dist/ and the gate fails",
      "prove_fires_command": "printf '\\n<!-- prove -->\\n' >> base/AGENTS.base.md",
      "revert_command": "git checkout -- base/AGENTS.base.md",
      "severity": "blocking",
      "phase": "release",
      "needs": [
        "tests"
      ],
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "example",
      "command": "./harness check --manifest examples/consumer/harness.manifest.json && ./harness validate --manifest examples/consumer/harness.manifest.json",
      "protects": "the example consumer stays composed and valid against the pinned base",
      "prove_fires": "append to the example's composed AGENTS.md, then run the gate; expect exit 1",
      "prove_fires_command": "printf '\\n<!-- prove -->\\n' >> examples/consumer/AGENTS.md",
      "revert_command": "./harness sync --manifest examples/consumer/harness.manifest.json",
      "severity": "blocking",
      "after": [
        "harness-drift"
      ],
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "release-ready",
      "command": "./harness doctor --manifest harness.manifest.json --strict",
      "protects": "the release declares every recommended artifact, so no release ships with an undeclared gap",
      "prove_fires": "delete the declared manual-verification path, then run the gate; the warning becomes a failure and the gate exits 1",
      "prove_fires_command": "node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('harness.manifest.json','utf8'));delete m.governance.manualVerification;fs.writeFileSync('harness.manifest.json',JSON.stringify(m,null,2)+'\\n')\"",
      "revert_command": "git checkout -- harness.manifest.json",
      "severity": "blocking",
      "expect": {
        "forbid": [
          "harness:"
        ]
      }
    },
    {
      "id": "metrics",
      "command": "./harness metrics --manifest harness.manifest.json",
      "protects": "the recorded runs stay inside the declared quality budget",
      "prove_fires": "append a run with a failed gate to docs/metrics.jsonl, then run the gate; expect exit 1",
      "prove_fires_command": "printf '%s\\n' '{\"at\":\"2026-01-01T00:00:00.000Z\",\"version\":\"0.0.0\",\"tool\":\"0.0.0\",\"results\":[{\"id\":\"tests\",\"ok\":false,\"skipped\":false,\"timedOut\":false,\"ms\":1}]}' >> docs/metrics.jsonl",
      "revert_command": "git checkout -- docs/metrics.jsonl",
      "severity": "blocking",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "command-review",
      "command": "node scripts/check-command-review.mjs",
      "protects": "a review receipt binds a command to its revision and rejects a different expected command without sharing temporary state",
      "prove_fires": "Change the expected command in the tracked fixture; receipt binding must fail.",
      "prove_fires_command": "node -e \"require('fs').writeFileSync('docs/fixtures/command-review.json',JSON.stringify({command:'false'})+'\\n')\"",
      "revert_command": "git restore -- docs/fixtures/command-review.json",
      "severity": "blocking",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    }
  ],
