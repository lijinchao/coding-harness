{
  "version": "0.1.12",
  "tool": {
    "version": "0.1.12",
    "source": "git:https://github.com/lijinchao/coding-harness.git",
    "commit": "a962e8da0144f754d3595432a7c8d9a95186a5bd"
  },
  "base": {
    "source": "git:https://github.com/lijinchao/coding-harness.git",
    "registry": "dist",
    "cache": ".harness"
  },
  "compositions": [
    {
      "output": "AGENTS.md",
      "sources": [
        "base:AGENTS.base.md",
        "AGENTS.delta.md"
      ]
    },
    {
      "output": "REVIEW.md",
      "sources": [
        "base:REVIEW.base.md"
      ]
    }
  ],
  "skills": [
    {
      "id": "test-driven-development",
      "path": "base:skills/test-driven-development/SKILL.md",
      "trigger": "before writing implementation code",
      "owner": "@coding-harness"
    },
    {
      "id": "writing-a-gate",
      "path": "base:skills/writing-a-gate/SKILL.md",
      "trigger": "before adding a gate",
      "owner": "@coding-harness"
    }
  ],
  "gates": [
    {
      "id": "harness-drift",
      "command": "./harness check --manifest harness.manifest.json",
      "protects": "the composed AGENTS.md and REVIEW.md match base@0.1.12 plus this delta",
      "prove_fires": "hand-edit AGENTS.md, then run ./harness check; expect exit 1",
      "severity": "blocking",
      "prove_fires_command": "printf '<!-- prove -->\\n' >> AGENTS.md",
      "revert_command": "./harness sync --manifest harness.manifest.json",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "doctor",
      "command": "./harness doctor --manifest harness.manifest.json",
      "protects": "declared governance facts (version references, decision records, owner routing) stay consistent",
      "prove_fires": "remove a section from a decision record, then run ./harness doctor; expect exit 1",
      "prove_fires_command": "node -e \"const fs=require('fs');const p='docs/decisions/0001-base-distribution-and-boundaries.md';const s=fs.readFileSync(p,'utf8');fs.writeFileSync(p,s.replace('## Alternatives','## AlternativesX'))\"",
      "revert_command": "git checkout -- docs/decisions/0001-base-distribution-and-boundaries.md",
      "severity": "blocking",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "validate",
      "command": "./harness validate --manifest harness.manifest.json",
      "protects": "declared skills and gates carry their required sections",
      "prove_fires": "remove ## Verification from a declared skill; expect exit 1",
      "severity": "blocking",
      "prove_fires_command": "node -e \"const fs=require('fs');const p='harness.manifest.json';const m=JSON.parse(fs.readFileSync(p));m.__prove=true;fs.writeFileSync(p,JSON.stringify(m,null,2)+'\\n')\"",
      "revert_command": "node -e \"const fs=require('fs');const p='harness.manifest.json';const m=JSON.parse(fs.readFileSync(p));delete m.__prove;fs.writeFileSync(p,JSON.stringify(m,null,2)+'\\n')\"",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "tests",
      "command": "npm test",
      "protects": "the CLI and its checks stay green",
      "prove_fires": "break a test expectation; expect exit 1",
      "severity": "blocking",
      "prove_fires_command": "node -e \"require('fs').writeFileSync('test/__prove.test.mjs','throw new Error()')\"",
      "revert_command": "node -e \"require('fs').rmSync('test/__prove.test.mjs',{force:true})\"",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    }
  ],
  "governance": {
    "version": [
      "README.md",
      "docs/roadmap.md"
    ],
    "decisions": "docs/decisions",
    "owners": [
      "@lijinchao"
    ],
    "ci": [
      ".github/workflows/harness.yml"
    ]
  }
}
