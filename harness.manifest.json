      "AGENTS.delta.md",
      "examples/consumer/AGENTS.md",
      "examples/consumer/AGENTS.delta.md"
    ],
    "postmortems": "docs/postmortems",
    "manualVerification": "docs/MANUAL_VERIFICATION.md",
    "proofs": {
      "require": "blocking",
      "maxAgeDays": 30
    }
  },
