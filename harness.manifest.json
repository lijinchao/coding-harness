    {
      "id": "output",
      "paths": [
        "AGENTS.md",
        "REVIEW.md",
        "harness",
        "harness.manifest.json",
        ".github/**",
        ".gitignore"
      ],
      "requires": [
        "harness-drift",
        "doctor",
        "validate",
        "release-ready"
      ]
    },
    {
      "id": "delta",
      "paths": [
        "AGENTS.delta.md"
      ],
      "requires": [
        "harness-drift"
      ]
    },
    {
      "id": "pack-sources",
      "paths": [
        "packs/**"
      ],
      "requires": [
        "harness-drift",
        "validate",
        "tests"
      ]
    },
    {
      "id": "docs",
      "paths": [
        "docs/**",
        "README.md"
      ],
      "requires": [
        "doctor",
        "validate",
        "metrics"
      ]
