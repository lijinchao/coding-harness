{
  "version": "0.1.49",
  "tool": {
    "version": "0.1.49",
    "source": "git:https://github.com/lijinchao/coding-harness.git",
    "commit": "c5fb3cd3dd92f32b49861ba18b0d341819ff951c"
  },
  "base": {
    "source": "git:https://github.com/lijinchao/coding-harness.git",
    "registry": "dist",
    "cache": ".harness"
  },
  "packs": [
    {
      "id": "delivery-flow",
      "source": "dist/packs/delivery-flow",
      "version": "0.1.1"
    }
  ],
  "product": {
    "version": {
      "path": "base/VERSION"
    },
    "mentions": [
      "README.md",
      "docs/roadmap.md"
    ]
  },
  "compositions": [
    {
      "output": "AGENTS.md",
      "sources": [
        "base:AGENTS.base.md",
        "AGENTS.delta.md"
      ]
    },
    {
      "output": "REVIEW.md",
      "sources": [
        "base:REVIEW.base.md"
      ]
    },
    {
      "output": ".agents/skills/test-driven-development/SKILL.md",
      "sources": [
        "base:skills/test-driven-development/SKILL.md"
      ]
    },
    {
      "output": ".agents/skills/writing-a-gate/SKILL.md",
      "sources": [
        "base:skills/writing-a-gate/SKILL.md"
      ]
    },
    {
      "output": ".agents/skills/verification-tiers/SKILL.md",
      "sources": [
        "base:skills/verification-tiers/SKILL.md"
      ]
    },
    {
      "output": ".claude/skills/test-driven-development/SKILL.md",
      "sources": [
        "base:skills/test-driven-development/SKILL.md"
      ]
    },
    {
      "output": ".claude/skills/writing-a-gate/SKILL.md",
      "sources": [
        "base:skills/writing-a-gate/SKILL.md"
      ]
    },
    {
      "output": ".claude/skills/verification-tiers/SKILL.md",
      "sources": [
        "base:skills/verification-tiers/SKILL.md"
      ]
    }
  ],
  "skills": [
    {
      "id": "test-driven-development",
      "path": "base:skills/test-driven-development/SKILL.md",
      "trigger": "before writing implementation code",
      "owner": "@lijinchao"
    },
    {
      "id": "writing-a-gate",
      "path": "base:skills/writing-a-gate/SKILL.md",
      "trigger": "before adding a gate",
      "owner": "@lijinchao"
    },
    {
      "id": "verification-tiers",
      "path": "base:skills/verification-tiers/SKILL.md",
      "trigger": "before deciding which check proves a change",
      "owner": "@lijinchao"
    }
  ],
  "gates": [
    {
      "id": "harness-drift",
      "command": "./harness check --manifest harness.manifest.json",
      "protects": "all composed instructions and native skill exports match their pinned sources",
      "prove_fires": "corrupt a native skill export, then verify drift fails and sync restores it",
      "severity": "blocking",
      "prove_fires_command": "printf '\\n<!-- prove -->\\n' >> .agents/skills/verification-tiers/SKILL.md",
      "revert_command": "./harness sync --manifest harness.manifest.json",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      },
      "proof_inputs": [
        "bin/harness.mjs",
        "src/compose.mjs",
        "src/fetch.mjs",
        "src/pack.mjs",
        "src/process.mjs",
        "src/proof.mjs",
        "src/shim.mjs",
        "src/state.mjs",
        "src/tool.mjs"
      ]
    },
    {
      "id": "doctor",
      "command": "./harness doctor --manifest harness.manifest.json",
      "protects": "declared governance facts, owner routing and reachable context sources stay consistent",
      "prove_fires": "make a declared context source point to a missing file; doctor must fail",
      "prove_fires_command": "node -e \"const fs=require('fs');const p='harness.manifest.json';const m=JSON.parse(fs.readFileSync(p));m.governance.context.sources[0].path='__missing_context__.md';fs.writeFileSync(p,JSON.stringify(m,null,2)+'\\n')\"",
      "revert_command": "git restore -- harness.manifest.json",
      "severity": "blocking",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      },
      "proof_inputs": [
        "bin/harness.mjs",
        "src/adopt.mjs",
        "src/artifacts.mjs",
        "src/context.mjs",
        "src/doctor.mjs",
        "src/documents.mjs",
        "src/manifest.mjs",
        "src/process.mjs",
        "src/product.mjs",
        "src/proof.mjs"
      ]
    },
    {
      "id": "validate",
      "command": "./harness validate --manifest harness.manifest.json",
      "protects": "declared skills and gates carry their required sections",
      "prove_fires": "remove ## Verification from a declared skill; expect exit 1",
      "severity": "blocking",
      "prove_fires_command": "node -e \"const fs=require('fs');const p='harness.manifest.json';const m=JSON.parse(fs.readFileSync(p));m.__prove=true;fs.writeFileSync(p,JSON.stringify(m,null,2)+'\\n')\"",
      "revert_command": "node -e \"const fs=require('fs');const p='harness.manifest.json';const m=JSON.parse(fs.readFileSync(p));delete m.__prove;fs.writeFileSync(p,JSON.stringify(m,null,2)+'\\n')\"",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      },
      "proof_inputs": [
        "bin/harness.mjs",
        "schema/harness.manifest.schema.json",
        "src/artifacts.mjs",
        "src/manifest.mjs",
        "src/process.mjs",
        "src/proof.mjs"
      ]
    },
    {
      "id": "tests",
      "command": "npm test",
      "protects": "the CLI and its checks stay green",
      "prove_fires": "break a test expectation; expect exit 1",
      "severity": "blocking",
      "prove_fires_command": "node -e \"require('fs').writeFileSync('test/__prove.test.mjs','throw new Error()')\"",
      "revert_command": "node -e \"require('fs').rmSync('test/__prove.test.mjs',{force:true})\"",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      },
      "proof_inputs": [
        "bin/harness.mjs",
        "package.json",
        "scripts/capture-delivery-pilot.mjs",
        "scripts/check-command-review.mjs",
        "scripts/check-delivery.mjs",
        "scripts/native-agent-eval.mjs",
        "src/adopt.mjs",
        "src/artifacts.mjs",
        "src/attest.mjs",
        "src/command-review.mjs",
        "src/compose.mjs",
        "src/context.mjs",
        "src/doctor.mjs",
        "src/documents.mjs",
        "src/external-hints.mjs",
        "src/fetch.mjs",
        "src/gates.mjs",
        "src/manifest.mjs",
        "src/metrics.mjs",
        "src/pack.mjs",
        "src/process.mjs",
        "src/product.mjs",
        "src/proof.mjs",
        "src/prove.mjs",
        "src/release.mjs",
        "src/scan.mjs",
        "src/select.mjs",
        "src/shim.mjs",
        "src/state.mjs",
        "src/survey.mjs",
        "src/system-ci-template.mjs",
        "src/system-gitlab.mjs",
        "src/system.mjs",
        "src/tool.mjs",
        "src/workflow.mjs",
        "src/worktree.mjs",
        "test/adopt.test.mjs",
        "test/artifacts.test.mjs",
        "test/attest.test.mjs",
        "test/batch-c.test.mjs",
        "test/command-review-gate.test.mjs",
        "test/command-review.test.mjs",
        "test/context-map.test.mjs",
        "test/delivery-evidence.test.mjs",
        "test/delivery-flow.test.mjs",
        "test/doctor.test.mjs",
        "test/documents.test.mjs",
        "test/evals.test.mjs",
        "test/failclosed.test.mjs",
        "test/gates.test.mjs",
        "test/harness.test.mjs",
        "test/journeys.test.mjs",
        "test/legibility.test.mjs",
        "test/metrics.test.mjs",
        "test/native-eval.test.mjs",
        "test/offline.test.mjs",
        "test/output-assertions.test.mjs",
        "test/pack-conformance.test.mjs",
        "test/pack-proof-record.test.mjs",
        "test/packs.test.mjs",
        "test/pinned-base.test.mjs",
        "test/postmortems.test.mjs",
        "test/product.test.mjs",
        "test/proof-failure-boundary.test.mjs",
        "test/proof-inputs.test.mjs",
        "test/proofs.test.mjs",
        "test/scan-prove.test.mjs",
        "test/schema-agreement.test.mjs",
        "test/select.test.mjs",
        "test/self-consumption.test.mjs",
        "test/self-product-status.test.mjs",
        "test/shim.test.mjs",
        "test/strictness.test.mjs",
        "test/survey.test.mjs",
        "test/system-ci-template.test.mjs",
        "test/system-gitlab.test.mjs",
        "test/system.test.mjs",
        "test/tool-pin.test.mjs",
        "test/workflow.test.mjs"
      ]
    },
    {
      "id": "release",
      "command": "V=$(cat base/VERSION); mkdir -p .harness/tmp && OUT=$(mktemp -d .harness/tmp/release.XXXXXX); node bin/harness.mjs release --base base --out \"$OUT\" --version \"$V\" --force >/dev/null && diff -r \"$OUT/base@$V\" \"dist/base@$V\"; s=$?; rm -rf \"$OUT\"; exit $s",
      "protects": "the committed base release matches what base/ produces at the pinned version; the scratch directory lives under the ignored .harness/tmp so the gate also runs where the platform temp directory is not writable",
      "prove_fires": "append to base/AGENTS.base.md without re-releasing; the rebuilt artifact differs from dist/ and the gate fails",
      "prove_fires_command": "printf '\\n<!-- prove -->\\n' >> base/AGENTS.base.md",
      "revert_command": "git checkout -- base/AGENTS.base.md",
      "severity": "blocking",
      "phase": "release",
      "needs": [
        "tests"
      ],
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      },
      "proof_inputs": [
        "bin/harness.mjs",
        "src/process.mjs",
        "src/proof.mjs",
        "src/release.mjs"
      ]
    },
    {
      "id": "example",
      "command": "./harness check --manifest examples/consumer/harness.manifest.json && ./harness validate --manifest examples/consumer/harness.manifest.json",
      "protects": "the example consumer stays composed and valid against the pinned base",
      "prove_fires": "append to the example's composed AGENTS.md, then run the gate; expect exit 1",
      "prove_fires_command": "printf '\\n<!-- prove -->\\n' >> examples/consumer/AGENTS.md",
      "revert_command": "./harness sync --manifest examples/consumer/harness.manifest.json",
      "severity": "blocking",
      "after": [
        "harness-drift"
      ],
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      },
      "proof_inputs": [
        "bin/harness.mjs",
        "src/compose.mjs",
        "src/fetch.mjs",
        "src/manifest.mjs",
        "src/process.mjs",
        "src/proof.mjs",
        "src/state.mjs"
      ]
    },
    {
      "id": "release-ready",
      "command": "./harness doctor --manifest harness.manifest.json --strict",
      "protects": "the release declares every recommended artifact, so no release ships with an undeclared gap",
      "prove_fires": "delete the declared manual-verification path, then run the gate; the warning becomes a failure and the gate exits 1",
      "prove_fires_command": "node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('harness.manifest.json','utf8'));delete m.governance.manualVerification;fs.writeFileSync('harness.manifest.json',JSON.stringify(m,null,2)+'\\n')\"",
      "revert_command": "git checkout -- harness.manifest.json",
      "severity": "blocking",
      "expect": {
        "forbid": [
          "harness:"
        ]
      },
      "proof_inputs": [
        "bin/harness.mjs",
        "src/adopt.mjs",
        "src/artifacts.mjs",
        "src/context.mjs",
        "src/doctor.mjs",
        "src/documents.mjs",
        "src/manifest.mjs",
        "src/process.mjs",
        "src/product.mjs",
        "src/proof.mjs"
      ]
    },
    {
      "id": "metrics",
      "command": "node -e \"console.log('historical gate-health only; not current delivery qualification')\" && ./harness metrics --manifest harness.manifest.json",
      "protects": "Historical gate-health budget diagnostic only; current CI report owns the current run, not delivery effectiveness.",
      "prove_fires": "append a run with a failed gate to docs/metrics.jsonl, then run the gate; expect exit 1",
      "prove_fires_command": "printf '%s\\n' '{\"at\":\"2026-01-01T00:00:00.000Z\",\"version\":\"0.0.0\",\"tool\":\"0.0.0\",\"results\":[{\"id\":\"tests\",\"ok\":false,\"skipped\":false,\"timedOut\":false,\"ms\":1}]}' >> docs/metrics.jsonl",
      "revert_command": "git checkout -- docs/metrics.jsonl",
      "severity": "advisory",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      },
      "proof_inputs": [
        "bin/harness.mjs",
        "src/metrics.mjs",
        "src/process.mjs",
        "src/proof.mjs"
      ]
    },
    {
      "id": "command-review",
      "command": "node scripts/check-command-review.mjs",
      "protects": "Mechanism smoke only: receipt binding rejects a different expected command without shared temporary state; not delivery qualification.",
      "prove_fires": "Change the expected command in the tracked fixture; receipt binding must fail.",
      "prove_fires_command": "node -e \"require('fs').writeFileSync('docs/fixtures/command-review.json',JSON.stringify({command:'false'})+'\\n')\"",
      "revert_command": "git restore -- docs/fixtures/command-review.json",
      "severity": "blocking",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      },
      "proof_inputs": [
        "bin/harness.mjs",
        "docs/fixtures/command-review.json",
        "scripts/check-command-review.mjs",
        "src/command-review.mjs",
        "src/process.mjs",
        "src/proof.mjs"
      ]
    },
    {
      "id": "delivery-flow/plan",
      "command": "node scripts/check-delivery.mjs --manifest delivery.plan.json --stage planned",
      "protects": "Active acceptance-map preflight only; planned does not mean verified or human accepted.",
      "prove_fires": "Empty the acceptance criteria; the plan check must fail, then pass after revert.",
      "prove_fires_command": "node -e \"const fs=require('fs');const p='delivery.plan.json';const m=JSON.parse(fs.readFileSync(p));m.acceptance=[];fs.writeFileSync(p,JSON.stringify(m,null,2)+'\\n')\"",
      "revert_command": "git restore -- delivery.plan.json",
      "severity": "blocking",
      "expect": {
        "forbid": [
          "\"status\": \"blocked\""
        ]
      },
      "always": true,
      "override": true,
      "proof_inputs": [
        "scripts/check-delivery.mjs",
        "dist/packs/delivery-flow/base@0.1.1/check.mjs",
        "dist/packs/delivery-flow/base@0.1.1/delivery.schema.json"
      ]
    }
  ],
