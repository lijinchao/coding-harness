        "harness-drift",
        "tests",
        "example"
      ]
    },
    {
      "id": "output",
      "paths": [
        "AGENTS.md",
        "REVIEW.md",
        "harness",
        "harness.manifest.json",
        ".github/**",
        ".gitignore"
      ],
      "requires": [
