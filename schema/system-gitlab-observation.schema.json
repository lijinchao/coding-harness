{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-harness/system-gitlab-observation.schema.json",
  "title": "Coding harness GitLab read-only observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system_id", "change_id", "manifest_sha256", "targets_sha256", "observed_at", "host", "results", "valid", "remote_reads", "commands_executed", "note"],
  "properties": {
    "schema_version": { "const": "coding-harness.gitlab-observation/v1" },
    "system_id": { "type": "string", "minLength": 1 },
    "change_id": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targets_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observed_at": { "type": "string", "minLength": 1 },
    "host": { "type": "string", "minLength": 1 },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "project_id", "project_path", "mr_iid", "expected_revision", "mr_sha", "approval_rules", "pipeline", "jobs", "ok", "problems"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "project_id": { "type": "integer", "minimum": 1 },
          "project_path": { "type": "string", "minLength": 1 },
          "mr_iid": { "type": "integer", "minimum": 1 },
          "expected_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "mr_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
          "approval_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "required", "approved", "approver_ids"],
              "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "name": { "type": "string", "minLength": 1 },
                "required": { "type": "integer", "minimum": 1 },
                "approved": { "type": "boolean" },
                "approver_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
              }
            }
          },
          "pipeline": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["id", "sha", "source", "status"],
            "properties": {
              "id": { "type": ["integer", "null"], "minimum": 1 },
              "sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
              "source": { "type": ["string", "null"] },
              "status": { "type": ["string", "null"] }
            }
          },
          "jobs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "status", "pipeline_id"],
              "properties": {
                "id": { "type": ["integer", "null"], "minimum": 1 },
                "name": { "type": "string", "minLength": 1 },
                "status": { "type": ["string", "null"] },
                "pipeline_id": { "type": ["integer", "null"], "minimum": 1 }
              }
            }
          },
          "ok": { "type": "boolean" },
          "problems": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "valid": { "type": "boolean" },
    "remote_reads": { "const": true },
    "commands_executed": { "const": false },
    "note": { "type": "string", "minLength": 1 }
  }
}
