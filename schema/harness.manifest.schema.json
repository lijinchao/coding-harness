{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-harness/manifest.schema.json",
  "title": "Coding harness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "compositions", "skills", "gates"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "pattern": { "type": "string", "minLength": 1 }
          }
        },
        "mentions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decisions": { "type": "string", "minLength": 1 },
        "owners": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "ci": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "changes": { "type": "string", "minLength": 1 },
        "manualVerification": { "type": "string", "minLength": 1 },
        "docs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "maxWords": { "type": "integer", "minimum": 1 },
              "forbid": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "allow": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "instructions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "postmortems": { "type": "string", "minLength": 1 },
        "proofCarry": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "proofs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require": { "enum": ["blocking", "all", "none"] },
            "maxAgeDays": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "registry": { "type": "string", "minLength": 1 },
        "cache": { "type": "string", "minLength": 1 }
      }
    },
    "compositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output", "sources"],
        "properties": {
          "output": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "trigger", "owner"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "protects", "prove_fires", "severity"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "protects": { "type": "string", "minLength": 1 },
          "prove_fires": { "type": "string", "minLength": 1 },
          "prove_fires_command": { "type": "string", "minLength": 1 },
          "revert_command": { "type": "string", "minLength": 1 },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "forbid": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "allow": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "severity": { "enum": ["blocking", "advisory"] },
          "phase": { "type": "string", "minLength": 1 },
          "always": { "type": "boolean" },
          "needs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "after": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths", "requires"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "requires": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "outputs"],
      "properties": {
        "version": { "type": "string" },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": { "type": "string" },
            "commit": { "type": "string" },
            "files": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "files"],
          "properties": {
            "version": { "type": "string" },
            "files": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "outputs": { "type": "object", "additionalProperties": { "type": "string" } },
        "proofs": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
