{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-harness/system-receipt.schema.json",
  "title": "Coding harness system run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system_id", "manifest", "tier", "started_at", "finished_at", "repositories", "results", "status"],
  "properties": {
    "schema_version": { "const": "coding-harness.system-receipt/v1" },
    "system_id": { "type": "string", "minLength": 1 },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "tier": { "enum": ["harness-check", "unit", "contract", "integration", "external-qualified"] },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": "string", "minLength": 1 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "command", "ok", "exit_code", "signal", "timed_out", "duration_ms", "stdout", "stderr"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "ok": { "type": "boolean" },
          "exit_code": { "type": "integer", "minimum": 0 },
          "signal": { "type": ["string", "null"] },
          "timed_out": { "type": "boolean" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "stdout": { "$ref": "#/definitions/stream" },
          "stderr": { "$ref": "#/definitions/stream" }
        }
      }
    },
    "status": { "enum": ["passed", "failed"] }
  },
  "definitions": {
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
