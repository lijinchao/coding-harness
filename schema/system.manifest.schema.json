{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-harness/system-manifest.schema.json",
  "title": "Coding harness system manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "repositories", "contracts", "verifications", "qualification"],
  "properties": {
    "schema_version": { "const": "coding-harness.system/v1" },
    "id": { "type": "string", "minLength": 1 },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "records"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "path"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "path", "revision"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "producer", "consumers", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "producer": { "type": "string", "minLength": 1 },
          "consumers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "path"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "verifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "tier", "command", "external", "reviewed_by"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "minLength": 1 },
          "tier": { "enum": ["harness-check", "unit", "contract", "integration", "external-qualified"] },
          "command": { "type": "string", "minLength": 1 },
          "external": { "type": "boolean" },
          "reviewed_by": { "type": "string", "minLength": 1 }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_tiers", "max_receipt_age_seconds", "promotion"],
      "properties": {
        "required_tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["harness-check", "unit", "contract", "integration", "external-qualified"] }
        },
        "max_receipt_age_seconds": { "type": "integer", "minimum": 1 },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["history_window", "minimum_runs", "minimum_healthy_rate", "minimum_consecutive_healthy_runs"],
          "properties": {
            "history_window": { "type": "integer", "minimum": 1 },
            "minimum_runs": { "type": "integer", "minimum": 1 },
            "minimum_healthy_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "minimum_consecutive_healthy_runs": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
