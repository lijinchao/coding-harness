#!/bin/sh
# Bootstrap and run the pinned coding-harness tool (generated by harness init).
set -e
manifest=harness.manifest.json
version=$(node -p "require('./$manifest').tool.version")
source=$(node -p "const m=require('./$manifest');(m.tool&&m.tool.source)||(m.base&&m.base.source)||''")
case "$source" in
  git:*)
    url=${source#git:}
    dir=".harness/tool/v$version"
    if [ ! -d "$dir/.git" ]; then
      git clone --depth 1 --branch "v$version" --no-tags "$url" "$dir"
    fi
    tool="$dir/bin/harness.mjs"
    ;;
  *)
    tool="$(dirname "$source")/bin/harness.mjs"
    ;;
esac
exec node "$tool" "$@"