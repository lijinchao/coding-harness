#!/bin/sh
# Bootstrap and run the pinned coding-harness tool (generated by harness init).
set -e
offline=${HARNESS_OFFLINE:-0}
for arg in "$@"; do
  if [ "$arg" = '--offline' ]; then offline=1; fi
done
export HARNESS_OFFLINE="$offline"
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
manifest="$root/harness.manifest.json"
version=$(node -e 'const m=require(process.argv[1]);process.stdout.write((m.tool&&m.tool.version)||"")' "$manifest")
commit=$(node -e 'const m=require(process.argv[1]);process.stdout.write((m.tool&&m.tool.commit)||"")' "$manifest")
source=$(node -e 'const m=require(process.argv[1]);process.stdout.write((m.tool&&m.tool.source)||(m.base&&m.base.source)||"")' "$manifest")
case "$source" in
  git:*)
    url=${source#git:}
    dir="$root/.harness/tool/v$version"
    if [ ! -d "$dir/.git" ] && [ -n "$commit" ]; then
      common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
      case "$common" in
        */.git)
          shared="$(dirname -- "$common")/.harness/tool/v$version"
          if [ -d "$shared/.git" ]; then dir="$shared"; fi
          ;;
      esac
    fi
    if [ ! -d "$dir/.git" ]; then
      if [ "$offline" = 1 ]; then
        echo "harness: offline tool cache miss for v$version; populate the pinned dependency online first" >&2
        exit 1
      fi
      node -e 'const r=require("node:child_process").spawnSync("git",["-c","http.lowSpeedLimit=1024","-c","http.lowSpeedTime=15",...process.argv.slice(1)],{stdio:"inherit",timeout:30000,killSignal:"SIGKILL"});if(r.error)console.error("harness: tool fetch failed: "+r.error.message);process.exit(r.status??1)' clone --depth 1 --branch "v$version" --no-tags "$url" "$dir"
    fi
    if [ -n "$commit" ]; then
      actual=$(git -C "$dir" rev-parse HEAD)
      if [ "$actual" != "$commit" ]; then
        echo "harness: fetched tool $actual does not match pinned $commit" >&2
        exit 1
      fi
    fi
    tool="$dir/bin/harness.mjs"
    ;;
  /*) if [ -f "$source/bin/harness.mjs" ]; then tool="$source/bin/harness.mjs"; else tool=$(dirname -- "$source")/bin/harness.mjs; fi ;;
  *) if [ -f "$root/$source/bin/harness.mjs" ]; then tool="$root/$source/bin/harness.mjs"; else tool=$(dirname -- "$root/$source")/bin/harness.mjs; fi ;;
esac
cd "$root"
exec node "$tool" "$@"