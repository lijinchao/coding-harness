#!/bin/sh
# Bootstrap and run the pinned coding-harness tool (generated by harness init).
set -e
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
manifest="$root/harness.manifest.json"
version=$(node -e 'const m=require(process.argv[1]);process.stdout.write((m.tool&&m.tool.version)||"")' "$manifest")
commit=$(node -e 'const m=require(process.argv[1]);process.stdout.write((m.tool&&m.tool.commit)||"")' "$manifest")
source=$(node -e 'const m=require(process.argv[1]);process.stdout.write((m.tool&&m.tool.source)||(m.base&&m.base.source)||"")' "$manifest")
case "$source" in
  git:*)
    url=${source#git:}
    dir="$root/.harness/tool/v$version"
    if [ ! -d "$dir/.git" ]; then
      git clone --depth 1 --branch "v$version" --no-tags "$url" "$dir"
    fi
    if [ -n "$commit" ]; then
      actual=$(git -C "$dir" rev-parse HEAD)
      if [ "$actual" != "$commit" ]; then
        echo "harness: fetched tool $actual does not match pinned $commit" >&2
        exit 1
      fi
    fi
    tool="$dir/bin/harness.mjs"
    ;;
  /*) if [ -f "$source/bin/harness.mjs" ]; then tool="$source/bin/harness.mjs"; else tool=$(dirname -- "$source")/bin/harness.mjs; fi ;;
  *) if [ -f "$root/$source/bin/harness.mjs" ]; then tool="$root/$source/bin/harness.mjs"; else tool=$(dirname -- "$root/$source")/bin/harness.mjs; fi ;;
esac
cd "$root"
exec node "$tool" "$@"