{
  "schema_version": "coding-harness.delivery/v2",
  "id": "project-owned-behavior-evidence",
  "outcome": "Bind existing behavior scenarios and honest tier evidence to the candidate without changing legacy consumers.",
  "design": "docs/changes/wisharness-spec-adoption/spec.md",
  "constraints": [
    "Opt-in pack contract; Kernel/base stays 0.1.49 and v1 keeps its semantics",
    "No new executor, dependency, consumer product change or automatic human acceptance",
    "Behavior text stays in its existing source; machine map stores only references and check links"
  ],
  "scope": [
    "packs/delivery-flow",
    "dist/packs/delivery-flow/base@0.2.2",
    "docs/changes/wisharness-spec-adoption/spec.md",
    "docs/changes/wisharness-spec-adoption/plan.md",
    "docs/decisions/0054-project-owned-behavior-evidence.md",
    "docs/packs.md",
    "docs/contracts.md",
    "docs/index.md",
    "delivery.plan.json",
    "harness.manifest.json",
    "scripts/check-delivery.mjs",
    "test/delivery-v2.test.mjs",
    "test/delivery-v2-boundaries.test.mjs"
  ],
  "acceptance": [
    {
      "id": "AC-SOURCE",
      "scenario": "AC-01",
      "description": "Reuse tracked project-owned behavior and stable scenario references",
      "checks": [
        "unit",
        "policy"
      ]
    },
    {
      "id": "AC-REFERENCES",
      "scenario": "AC-02",
      "description": "Invalid source paths or scenario references fail closed",
      "checks": [
        "unit",
        "policy",
        "boundary"
      ]
    },
    {
      "id": "AC-DRIFT",
      "scenario": "AC-03",
      "description": "Source and plan drift invalidate candidate evidence",
      "checks": [
        "policy"
      ]
    },
    {
      "id": "AC-TIERS",
      "scenario": "AC-04",
      "description": "Missing or blocked tier evidence cannot become verified",
      "checks": [
        "policy",
        "operator"
      ]
    },
    {
      "id": "AC-LEGACY",
      "scenario": "AC-05",
      "description": "Legacy behavior is unchanged and migration is explicit",
      "checks": [
        "policy"
      ]
    },
    {
      "id": "AC-SELF",
      "scenario": "AC-06",
      "description": "The actual self consumer uses the new pinned pack and named checks",
      "checks": [
        "policy",
        "operator"
      ]
    }
  ],
  "checks": [
    {
      "id": "unit",
      "tier": "unit",
      "command": "node --test --test-name-pattern='v2 unit' test/delivery-v2.test.mjs",
      "test_files": [
        "test/delivery-v2.test.mjs"
      ],
      "expected_failure": "v2 unit"
    },
    {
      "id": "policy",
      "tier": "integration",
      "command": "node --test --test-name-pattern='v2 policy|v2 evidence|v2 self' test/delivery-v2.test.mjs",
      "test_files": [
        "test/delivery-v2.test.mjs"
      ],
      "expected_failure": "v2 policy"
    },
    {
      "id": "operator",
      "tier": "e2e",
      "command": "node --test --test-name-pattern='v2 operator' test/delivery-v2.test.mjs",
      "test_files": [
        "test/delivery-v2.test.mjs"
      ],
      "expected_failure": "v2 operator"
    },
    {
      "id": "boundary",
      "tier": "integration",
      "command": "node --test test/delivery-v2-boundaries.test.mjs",
      "test_files": [
        "test/delivery-v2-boundaries.test.mjs"
      ],
      "expected_failure": "v2 boundary"
    }
  ],
  "tiers": [
    {
      "tier": "unit",
      "status": "covered",
      "reason": "Pure scenario extraction has explicit unit assertions"
    },
    {
      "tier": "integration",
      "status": "covered",
      "reason": "Git, schemas, candidate bytes and actual red/green receipts are exercised together"
    },
    {
      "tier": "e2e",
      "status": "covered",
      "reason": "The local pack operator CLI is exercised; no SDK or production environment qualification is claimed"
    }
  ]
}
