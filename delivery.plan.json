{
  "schema_version": "coding-harness.delivery/v1",
  "id": "integration-and-proof-boundaries",
  "outcome": "The integrated tool preserves upstream capabilities and publishes verifiable context, delivery and proof behavior for owner review.",
  "design": "docs/decisions/0047-integrate-and-review-before-pr.md",
  "constraints": [
    "Zero runtime dependencies",
    "Keep published versions immutable",
    "No self-approval, automatic merge or game product changes",
    "Separate local evidence from remote CI and human acceptance"
  ],
  "scope": [
    "src",
    "bin",
    "schema",
    "test",
    "scripts",
    "packs",
    "dist",
    "base",
    "docs",
    "README.md",
    "harness.manifest.json",
    "examples/consumer"
  ],
  "acceptance": [
    {
      "id": "AC-01",
      "description": "Upstream capabilities and CLI inventory survive integration",
      "checks": [
        "suite"
      ]
    },
    {
      "id": "AC-02",
      "description": "Interrupted or unrestored failures cannot create successful proofs",
      "checks": [
        "proofs"
      ]
    },
    {
      "id": "AC-03",
      "description": "Containment rejects Windows parent/sibling/drive escapes",
      "checks": [
        "paths"
      ]
    },
    {
      "id": "AC-04",
      "description": "Proof qualification reaches both metrics summaries",
      "checks": [
        "metrics"
      ]
    },
    {
      "id": "AC-05",
      "description": "Immutable release and consumer pins validate",
      "checks": [
        "pins",
        "suite"
      ]
    }
  ],
  "checks": [
    {
      "id": "suite",
      "tier": "integration",
      "command": "npm test",
      "test_files": [
        "test/self-product-status.test.mjs",
        "test/delivery-flow.test.mjs"
      ]
    },
    {
      "id": "proofs",
      "tier": "integration",
      "command": "node --test test/proof-failure-boundary.test.mjs",
      "test_files": [
        "test/proof-failure-boundary.test.mjs"
      ]
    },
    {
      "id": "paths",
      "tier": "unit",
      "command": "node --test --test-name-pattern=containment test/context-map.test.mjs",
      "test_files": [
        "test/context-map.test.mjs"
      ]
    },
    {
      "id": "metrics",
      "tier": "integration",
      "command": "node --test test/gates.test.mjs test/metrics.test.mjs",
      "test_files": [
        "test/gates.test.mjs",
        "test/metrics.test.mjs"
      ]
    },
    {
      "id": "pins",
      "tier": "integration",
      "command": "./harness check --manifest harness.manifest.json && ./harness check --manifest examples/consumer/harness.manifest.json",
      "test_files": [
        "harness.manifest.json",
        "examples/consumer/harness.manifest.json"
      ]
    }
  ],
  "tier_waivers": [
    {
      "tier": "e2e",
      "reason": "The mapped checks do not test an application or remote GitLab instance. Remote release bootstrap and PR CI are separately verified; no game E2E or owner acceptance is claimed."
    }
  ]
}
