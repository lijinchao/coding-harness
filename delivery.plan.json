{
  "schema_version": "coding-harness.delivery/v1",
  "id": "checker-inputs-and-offline-resolution",
  "outcome": "Invalidate checker implementation drift and resolve pinned dependencies without network access when explicitly offline.",
  "design": "docs/decisions/0051-proof-inputs-and-offline-resolution.md",
  "constraints": [
    "No runtime dependencies or business changes",
    "Explicit checker inputs, not inferred dependency closure",
    "No old-release edits, automatic merges, credential copying or cache deletion",
    "Offline mode only controls harness dependency acquisition"
  ],
  "scope": [
    "src",
    "bin",
    "schema",
    "test",
    "scripts",
    "packs",
    "dist",
    "base",
    "docs",
    "README.md",
    "harness.manifest.json",
    "examples/consumer",
    ".agents",
    ".claude",
    "AGENTS.delta.md",
    "harness",
    "package.json"
  ],
  "acceptance": [
    {
      "id": "AC-01",
      "description": "Self and example pin the immutable updated tool without drift",
      "checks": [
        "pins"
      ]
    },
    {
      "id": "AC-02",
      "description": "Changed checker bytes and missing offline dependencies fail closed",
      "checks": [
        "scoring"
      ]
    },
    {
      "id": "AC-03",
      "description": "Real CLI rejects hollowed checker proofs",
      "checks": [
        "cli-proof"
      ]
    },
    {
      "id": "AC-04",
      "description": "Verified caches work offline including manual Git worktrees",
      "checks": [
        "scoring"
      ]
    },
    {
      "id": "AC-05",
      "description": "Existing repository regressions remain green",
      "checks": [
        "suite"
      ]
    },
    {
      "id": "AC-06",
      "description": "Existing declaration hash and legacy policy behavior remain explicit",
      "checks": [
        "definitions"
      ]
    }
  ],
  "checks": [
    {
      "id": "scoring",
      "tier": "integration",
      "command": "node --test test/proof-inputs.test.mjs test/offline.test.mjs",
      "test_files": [
        "test/proof-inputs.test.mjs",
        "test/offline.test.mjs"
      ]
    },
    {
      "id": "cli-proof",
      "tier": "e2e",
      "command": "node --test --test-name-pattern='CLI records checker' test/proof-inputs.test.mjs",
      "test_files": [
        "test/proof-inputs.test.mjs"
      ]
    },
    {
      "id": "pins",
      "tier": "integration",
      "command": "./harness check --manifest harness.manifest.json && ./harness check --manifest examples/consumer/harness.manifest.json",
      "test_files": [
        "harness.manifest.json",
        "examples/consumer/harness.manifest.json"
      ]
    },
    {
      "id": "suite",
      "tier": "integration",
      "command": "npm test",
      "test_files": [
        "test/proof-inputs.test.mjs",
        "test/offline.test.mjs"
      ]
    },
    {
      "id": "definitions",
      "tier": "unit",
      "command": "node --test test/proofs.test.mjs",
      "test_files": [
        "test/proofs.test.mjs"
      ]
    }
  ],
  "tier_waivers": []
}
