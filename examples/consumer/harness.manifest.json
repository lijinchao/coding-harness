  "version": "0.1.22",
  "tool": {
    "version": "0.1.22"
  },
  "base": {
    "source": "../../dist"
  },
  "compositions": [
    {
      "output": "AGENTS.md",
      "sources": [
        "base:AGENTS.base.md",
        "AGENTS.delta.md"
      ]
    },
    {
      "output": "REVIEW.md",
      "sources": [
        "base:REVIEW.base.md"
      ]
    }
  ],
  "skills": [
    {
      "id": "test-driven-development",
      "path": "base:skills/test-driven-development/SKILL.md",
      "trigger": "before writing implementation code",
      "owner": "@platform"
    },
    {
      "id": "writing-a-gate",
      "path": "base:skills/writing-a-gate/SKILL.md",
      "trigger": "before adding a gate",
      "owner": "@platform"
    }
  ],
  "gates": [
    {
      "id": "harness-drift",
      "command": "harness check --manifest harness.manifest.json",
      "protects": "the composed AGENTS.md and REVIEW.md match base@0.1.22 plus this delta",
      "prove_fires": "hand-edit AGENTS.md, then run harness check; expect exit 1",
      "severity": "blocking",
      "prove_fires_command": "printf '<!-- prove -->' >> AGENTS.md",
      "revert_command": "node ../../bin/harness.mjs sync --manifest harness.manifest.json",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "doctor",
      "command": "harness doctor --manifest harness.manifest.json",
      "protects": "declared governance facts stay consistent",
      "prove_fires": "empty CODEOWNERS, then run harness doctor; expect exit 1",
      "prove_fires_command": "printf '' > CODEOWNERS",
      "revert_command": "git checkout -- CODEOWNERS",
      "severity": "blocking",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    },
    {
      "id": "lint",
      "command": "make lint",
      "protects": "zero warnings in the committed change",
      "prove_fires": "introduce an unused import; expect exit 1",
      "severity": "blocking",
      "prove_fires_command": "printf '// unused' >> src/index.js",
      "revert_command": "git checkout -- src/index.js",
      "expect": {
        "forbid": [
          "ERROR:"
        ]
      }
    }
  ],
  "surfaces": [
    {
      "id": "harness",
      "paths": [
        "harness.manifest.json",
        "AGENTS.delta.md",
        ".github/workflows/**"
      ],
      "requires": [
        "harness-drift",
        "doctor"
      ]
    },
    {
      "id": "docs",
      "paths": [
        "docs/**",
        "README.md"
      ],
      "requires": [
        "doctor",
        "lint"
      ]
    }
  ],
  "governance": {
    "owners": [
      "@platform"
    ],
    "ci": [
      ".github/workflows/harness.yml"
    ]
  },
